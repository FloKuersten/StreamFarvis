{
  "appId": "com.farvis.streamfarvis",
  "appName": "StreamFarvis",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "streamfarvis"
  },
  "android": {
    "backgroundColor": "#0c0c0f",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#0c0c0f",
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scrollEnabled": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
